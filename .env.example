# ===================================================================
# APEX ELECTRO B2B PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env or set these in your local/Vercel settings
# ===================================================================

# -------------------------------------------------------------------
# 1. GMAIL SMTP (Automated Dual Email Dispatch)
# Generate a 16-character App Password from:
# https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be ON in your Google Account)
# -------------------------------------------------------------------
GMAIL_USER=yourcompany@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where store owner / admin receives inquiry alerts ("Mere Pe Mail")
ADMIN_NOTIFICATION_EMAIL=admin@apexelectro.in

# Sender Name displayed on emails
SENDER_NAME=Apex Electro B2B Procurement

# -------------------------------------------------------------------
# 2. ALTERNATIVE: BREVO (SENDINBLUE) TRANSACTIONAL EMAIL SERVICE
# (Optional fallback if you prefer Brevo instead of Gmail SMTP)
# -------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=rfq@apexelectro.in
BREVO_SENDER_NAME=Apex Electro Industrial Procurement

# -------------------------------------------------------------------
# 3. SUPABASE DATABASE CONFIGURATION (Optional Cloud Database)
# -------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# -------------------------------------------------------------------
# 4. APPLICATION DOMAIN
# -------------------------------------------------------------------
SITE_URL=http://localhost:3000
